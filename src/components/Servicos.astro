---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { servicos } from '../data/content';
import { waLink } from '../data/site';
---

<section id="servicos" class="py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="Serviços"
      title="Toda a documentação do seu veículo em um só lugar"
      lead="Você conta o que precisa, a gente cuida do resto: taxas, formulários, prazos e Detran-PR."
    />

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        servicos.map((s) => (
          <li class="reveal">
            <a
              href={waLink(`Olá! Vim pelo site e quero saber sobre ${s.msg}.`)}
              target="_blank"
              rel="noopener"
              class="group flex h-full gap-4 rounded-2xl border border-line bg-white p-5 transition duration-300 hover:-translate-y-1 hover:border-gold-500/60 hover:shadow-[0_20px_40px_-24px_rgb(16_28_80/0.45)] sm:flex-col sm:gap-0 sm:p-6"
            >
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-navy-900 text-gold-400 transition group-hover:bg-gold-500 group-hover:text-navy-950 sm:size-12">
                <Icon name={s.icon} class="size-6" />
              </span>
              <div class="flex flex-1 flex-col">
                <h3 class="font-serif text-lg leading-snug font-semibold text-navy-900 sm:mt-5 sm:text-xl">{s.title}</h3>
                <p class="mt-1.5 flex-1 text-[0.95rem] leading-relaxed text-muted sm:mt-2">{s.text}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-gold-700 sm:mt-5">
                  Pedir orçamento
                  <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-10 flex flex-col items-center justify-between gap-5 rounded-2xl border border-dashed border-gold-500/50 bg-gold-300/10 px-6 py-6 text-center sm:flex-row sm:text-left">
      <p class="text-lg text-navy-900">
        <strong class="font-serif font-semibold">Não encontrou o que precisa?</strong>
        <span class="text-muted"> A gente resolve. É só chamar.</span>
      </p>
      <a href={waLink('Olá! Vim pelo site e preciso de um serviço que não encontrei na lista.')} target="_blank" rel="noopener" class="btn-navy shrink-0">
        <Icon name="whatsapp" class="size-5" />
        Falar com a gente
      </a>
    </div>
  </div>
</section>
