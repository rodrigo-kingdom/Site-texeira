---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site, waLink } from '../data/site';

const canais = [
  { icon: 'whatsapp', label: 'WhatsApp e telefone', value: site.phoneDisplay, href: waLink() },
  { icon: 'instagram', label: 'Instagram', value: site.instagramHandle, href: site.instagram },
  { icon: 'facebook', label: 'Facebook', value: 'Despachante Teixeira', href: site.facebook },
  { icon: 'mail', label: 'E-mail', value: site.email, href: `mailto:${site.email}` },
] as const;
---

<section id="contato" class="border-t border-line bg-white py-24 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHeading
        align="left"
        eyebrow="Contato"
        title="Venha nos visitar ou chame no WhatsApp"
        lead="Atendimento no escritório, pelo WhatsApp ou na sua casa. Escolha o que for melhor para você."
      />

      <ul class="mt-10 space-y-3">
        {
          canais.map((c) => (
            <li class="reveal">
              <a
                href={c.href}
                target={c.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener"
                class="group flex items-center gap-4 rounded-2xl border border-line p-4 transition hover:border-gold-500/60 hover:bg-paper"
              >
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-navy-900 text-gold-400">
                  <Icon name={c.icon} class="size-5" />
                </span>
                <span class="min-w-0 leading-tight">
                  <span class="block text-xs tracking-wider text-muted uppercase">{c.label}</span>
                  <span class="mt-1 block truncate font-semibold text-navy-900">{c.value}</span>
                </span>
                <Icon name="arrow" class="ml-auto size-4 shrink-0 text-gold-700 transition group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Cartão de endereço (sem iframe de mapa, para manter o site leve) -->
    <div class="reveal relative isolate flex flex-col justify-between overflow-hidden rounded-3xl bg-navy-900 p-8 text-white sm:p-10">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 opacity-[0.08] [background-image:radial-gradient(rgb(255_255_255)_1px,transparent_1px)] [background-size:18px_18px]"
      >
      </div>
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 -z-10 size-72 rounded-full bg-gold-500/20 blur-3xl"></div>

      <div>
        <Icon name="pin" class="size-10 text-gold-400" />
        <p class="eyebrow mt-6 text-gold-300">Nosso escritório</p>
        <address class="mt-4 font-serif text-3xl leading-snug not-italic sm:text-4xl">
          {site.address.street}
          <span class="block text-xl text-white/70 sm:text-2xl">
            {site.address.district} · {site.address.city}/{site.address.state}
          </span>
        </address>
        <p class="mt-3 text-sm text-white/50">CEP {site.address.zip}</p>

        {
          site.hours && (
            <p class="mt-6 flex items-center gap-2 text-white/80">
              <Icon name="clock" class="size-5 text-gold-400" />
              {site.hours}
            </p>
          )
        }
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn-gold">
          <Icon name="pin" class="size-5" />
          Como chegar
        </a>
        <a href={`tel:${site.phoneE164}`} class="btn-outline-light">
          <Icon name="phone" class="size-5" />
          Ligar
        </a>
      </div>
    </div>
  </div>
</section>
