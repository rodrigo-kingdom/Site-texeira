---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  tone?: 'light' | 'dark';
  align?: 'center' | 'left';
}

const { eyebrow, title, lead, tone = 'light', align = 'center' } = Astro.props;
const dark = tone === 'dark';
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class:list={['eyebrow', dark ? 'text-gold-300' : 'text-gold-700', align === 'center' && 'justify-center']}>
    {eyebrow}
  </p>
  <h2
    class:list={[
      'mt-4 font-serif text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-[2.6rem]',
      dark ? 'text-white' : 'text-navy-900',
    ]}
  >
    {title}
  </h2>
  {lead && <p class:list={['mt-4 text-lg leading-relaxed text-pretty', dark ? 'text-white/70' : 'text-muted']}>{lead}</p>}
</div>
